{
  "name": "jarvis-ai-assistant-platform",
  "version": "1.0.0",
  "private": true,
  "description": "JARVIS-inspired full-stack AI assistant with voice chat, website generation, coding tools, file intelligence, and a neon dashboard.",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev apps/web -p 3000",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "next build apps/web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start": "node apps/api/dist/server.js",
    "lint": "eslint apps --ext .ts,.tsx",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "latest",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "framer-motion": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "mongoose": "latest",
    "multer": "latest",
    "next": "latest",
    "openai": "latest",
    "pdf-parse": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tesseract.js": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.64.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
